# Copy to .env and fill in. .env is gitignored — never commit real values.

# Bexio Personal Access Token, full scope (developer.bexio.com/pat).
# Used by the read client in src/bexio/. Expires 6 months after creation.
BEXIO_TOKEN=

# OpenRouter API key — powers transcription (Whisper) and extraction (GPT).
# Required for real /api/quote calls. WITHOUT it, the endpoint falls back to the
# bundled Amina demo fixture so the loop still runs keyless.
OPENROUTER_API_KEY=

# Optional model overrides. Defaults live in src/llm/client.ts.
# OPENROUTER_MODEL=openai/gpt-4o
# Default STT is gpt-4o-transcribe (best number accuracy). whisper-large-v3-turbo
# is cheaper but dropped a digit on a real note — use only if cost forces it.
# OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo

# Supabase — persistence for quotes, clients, company profile.
# URL is set automatically. The SERVICE ROLE key is a secret you add yourself:
# Supabase dashboard → bati-assist → Project Settings → API → service_role.
# Server-side only (it bypasses RLS); never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Browser-safe auth keys for @supabase/ssr (anon/publishable — safe to ship to
# the client). Power email-OTP sign-in and the RLS-scoped user client.
# Supabase dashboard → Project Settings → API → Project URL / publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
